<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>Playscreen.Bridge</AssemblyName>
    <RootNamespace>Playscreen.Bridge</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Version de Playnite embarquée : 10.x (SDK 6.18). Ne pas copier le SDK dans la sortie. -->
    <PackageReference Include="PlayniteSDK" Version="6.18.0" ExcludeAssets="runtime" />
    <!-- Permet de compiler pour .NET Framework sous Linux (CI et environnement de Claude). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
